<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ejalshakti.gov.in</domain>
        <domain includeSubdomains="true">imd.gov.in</domain>
        <domain includeSubdomains="true">api.imd.gov.in</domain>
        <domain includeSubdomains="true">city.imd.gov.in</domain>
        <domain includeSubdomains="true">open-meteo.com</domain>
        <domain includeSubdomains="true">api.met.no</domain>
        <domain includeSubdomains="true">nominatim.openstreetmap.org</domain>
        <domain includeSubdomains="true">api.rainviewer.com</domain>
        <domain includeSubdomains="true">api.open-meteo.com</domain>
    </domain-config>
</network-security-config>

